// -*- mode: jsonc -*-
{
    // General Settings

    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    //"height": 24, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    //"spacing": 4, // Gaps between modules (4px)
    "reload_style_on_change": true, 
    "include": ["~/Projects/nixos/dotfiles/waybar/.config/waybar/modules.json"],

    // Modules
    "modules-left": [
        "hyprland/mode",
        "hyprland/scratchpad",
        "custom/media"
    ],
    "modules-center": [
        "custom/nixos",
        "clock",
        "hyprland/workspaces",
        "pulseaudio",
        "network",
        "battery",
        "backlight",
        "tray",
        "custom/power"
    ],
    "group/hardware":{
        "orientation": "horizontal",
        "modules":[
            "cpu",
            "memory",
            "temperature"
        ]
    }
}
