// -*- mode: jsonc -*-
{
    // General Settings

    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    //"height": 24, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    //"spacing": 4, // Gaps between modules (4px)
    "include": ["~/Projects/nixos/dotfiles/waybar/.config/waybar/modules.json"],

    // Modules
    "modules-left": [
        "custom/nixos",
        "hyprland/mode",
        "hyprland/scratchpad",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/workspaces",
    ],
    "modules-right": [
        //"mpd",
        //"idle_inhibitor",
        "pulseaudio",
        "network",
        //"power-profiles-daemon",
        "group/hardware",
        "backlight",
        //"keyboard-state",
        //"hyprland/language",
        //"battery",
        //"battery#bat2",
        "clock",
        "tray",
        "custom/power"
    ],
    "group/hardware":{
        "orientation": "horizontal",
        "modules":[
            "cpu",
        "memory",
        "temperature"
        ]
    }
}
